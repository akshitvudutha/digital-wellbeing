/* Digital Wellbeing - Ultra-Premium Glassmorphism & Fluent Light Theme */

QWidget {
    color: #1e293b;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Outfit", -apple-system, sans-serif;
    font-size: 13px;
    border: none;
    outline: none;
}

QMainWindow {
    background-color: #f3f5f9;
}

/* ─── Sidebar ────────────────────────────────────────────────────────── */
#sidebar {
    background-color: rgba(255, 255, 255, 0.9);
    border-right: 1px solid rgba(0, 0, 0, 0.05);
    min-width: 230px;
    max-width: 230px;
}

#sidebar_logo_label {
    font-size: 20px;
    font-weight: 800;
    color: #0078d4;
    padding: 32px 24px 6px 24px;
    letter-spacing: -0.3px;
}

#sidebar_subtitle_label {
    font-size: 11px;
    color: #64748b;
    padding: 0px 24px 28px 24px;
    font-weight: 600;
}

QPushButton#nav_btn {
    text-align: left;
    padding: 12px 18px;
    border-radius: 12px;
    margin: 4px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    background-color: transparent;
    border-left: 4px solid transparent;
}

QPushButton#nav_btn:hover {
    background-color: rgba(0, 0, 0, 0.04);
    color: #0f172a;
}

QPushButton#nav_btn[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(0, 120, 212, 0.08), stop:1 rgba(0, 120, 212, 0.01));
    color: #0078d4;
    font-weight: 700;
    border-left: 4px solid #0078d4;
}

/* ─── Content Area ────────────────────────────────────────────────────── */
#content_area {
    background-color: #f3f5f9;
}

#page_title {
    font-size: 28px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.6px;
}

#page_subtitle {
    font-size: 13px;
    color: #64748b;
}

/* ─── Stat Cards ──────────────────────────────────────────────────────── */
#stat_card {
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: 24px;
}

#stat_card:hover {
    border-color: rgba(0, 120, 212, 0.35);
    background-color: rgba(255, 255, 255, 0.95);
}

#stat_card_value {
    font-size: 34px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.6px;
}

#stat_card_label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    margin-top: 8px;
}

#stat_card_icon {
    font-size: 26px;
}

/* ─── Section Headers ─────────────────────────────────────────────────── */
#section_header {
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.2px;
}

/* ─── App Row / List ──────────────────────────────────────────────────── */
#apps_container {
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: 8px;
}

#app_row {
    background-color: transparent;
    border-radius: 12px;
    padding: 12px 18px;
    margin: 2px 4px;
}

#app_row:hover {
    background-color: rgba(0, 0, 0, 0.03);
}

#app_name_label {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
}

#app_category_label {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
}

#app_time_label {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
}

/* ─── Progress Bars ───────────────────────────────────────────────────── */
QProgressBar {
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #22c55e, stop:1 #0078d4);
}

/* ─── Scroll Areas ────────────────────────────────────────────────────── */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.2);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
}

/* ─── ComboBox ────────────────────────────────────────────────────────── */
QComboBox {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 8px 16px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 600;
    min-width: 150px;
}

QComboBox:hover {
    border-color: #0078d4;
    background-color: #ffffff;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #64748b;
    width: 0;
    height: 0;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    selection-background-color: rgba(0, 120, 212, 0.08);
    selection-color: #0078d4;
    outline: none;
    padding: 8px;
}

QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    border-radius: 8px;
    color: #334155;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(0, 0, 0, 0.03);
    color: #0f172a;
}

/* ─── Line Edit / Search ──────────────────────────────────────────────── */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 8px 16px;
    color: #0f172a;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #0078d4;
    background-color: #ffffff;
}

QLineEdit::placeholder {
    color: #94a3b8;
}

/* ─── Table / History ─────────────────────────────────────────────────── */
QTableWidget {
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    gridline-color: rgba(0, 0, 0, 0.03);
    selection-background-color: rgba(0, 120, 212, 0.08);
    selection-color: #0f172a;
}

QTableWidget::item {
    padding: 12px 18px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.03);
    color: #334155;
}

QTableWidget::item:selected {
    background-color: rgba(0, 120, 212, 0.08);
    color: #0078d4;
    font-weight: 600;
}

QHeaderView::section {
    background-color: rgba(255, 255, 255, 0.9);
    color: #64748b;
    padding: 12px 18px;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

QHeaderView {
    background-color: transparent;
}

/* ─── Buttons ─────────────────────────────────────────────────────────── */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3b82f6, stop:1 #0078d4);
    color: #ffffff;
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: 12px 24px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.1px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #60a5fa, stop:1 #1e40af);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0078d4, stop:1 #1d4ed8);
}

QPushButton#secondary_btn {
    background: rgba(255, 255, 255, 0.9);
    color: #475569;
    border: 1px solid rgba(0, 0, 0, 0.08);
}

QPushButton#secondary_btn:hover {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.15);
}

QPushButton#danger_btn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f87171, stop:1 #dc2626);
}

QPushButton#danger_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #fca5a5, stop:1 #b91c1c);
}

/* ─── CheckBox / Switch ───────────────────────────────────────────────── */
QCheckBox {
    color: #334155;
    spacing: 12px;
    font-size: 13px;
    font-weight: 600;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    border: 2px solid rgba(0, 0, 0, 0.12);
    background-color: transparent;
}

QCheckBox::indicator:hover {
    border-color: #0078d4;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

/* ─── Spin Box ────────────────────────────────────────────────────────── */
QSpinBox {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 8px 12px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 600;
}

QSpinBox:focus {
    border-color: #0078d4;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: rgba(0, 0, 0, 0.03);
    border-radius: 6px;
    width: 20px;
}

/* ─── Tool Tips ───────────────────────────────────────────────────────── */
QToolTip {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}

/* ─── Date Edit ───────────────────────────────────────────────────────── */
QDateEdit {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 8px 12px;
    color: #0f172a;
    font-size: 13px;
}

QDateEdit:focus {
    border-color: #0078d4;
}

QCalendarWidget {
    background-color: #ffffff;
    color: #0f172a;
}

/* ─── Separator ───────────────────────────────────────────────────────── */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: rgba(0, 0, 0, 0.05);
    background-color: rgba(0, 0, 0, 0.05);
}

/* ─── PyQtGraph Plot ──────────────────────────────────────────────────── */
pg--PlotWidget {
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.05);
}

/* ─── About Page ──────────────────────────────────────────────────────── */
#about_app_name {
    font-size: 22px;
    font-weight: 800;
    color: #0078d4;
    letter-spacing: -0.5px;
}

#about_version {
    font-size: 13px;
    color: #64748b;
    font-weight: 600;
}

#about_desc {
    font-size: 13px;
    line-height: 1.5;
    color: #334155;
}

#about_tech_lbl {
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
}

#about_tech_val {
    color: #0f172a;
    font-size: 12px;
    font-weight: 700;
}

#about_health_desc {
    font-size: 12px;
    line-height: 1.5;
    color: #64748b;
    font-style: italic;
}
