/* ============================================================================
   NYW DESIGN SYSTEM STYLESHEET
   Deep Obsidian Canvas, Subtle Frosted Surfaces, Restrained Emerald & Amber
   ============================================================================ */

/* Global Reset & Typography Stack */
QWidget {
    font-family: "Segoe UI Variable Display", "Segoe UI", "Inter", -apple-system, sans-serif;
    color: #F8FAFC;
}

/* ─── Keyboard Focus Indicators ────────────────────────────────────────── */
QAbstractButton:focus,
QWidget[mouse_focus_clears="true"]:focus {
    border: 2px solid #10B981;
}
QTabBar::tab:focus {
    border-bottom: 2px solid #10B981;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 2px solid #10B981;
}

QMainWindow, QDialog, QWidget#content_area {
    background-color: #080A0D;
}

/* ─── Sidebar Navigation Rail ──────────────────────────────────────────── */
QFrame#sidebar {
    background-color: rgba(10, 13, 18, 0.75);
    border-right: 1px solid rgba(255, 255, 255, 0.07);
}

QLabel#sidebar_logo_label {
    font-size: 18px;
    font-weight: 800;
    color: #F8FAFC;
    letter-spacing: -0.3px;
    line-height: 1.2;
}

QLabel#sidebar_subtitle_label {
    font-size: 11px;
    font-weight: 700;
    color: #10B981;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

/* Navigation Section Headers */
QLabel#nav_section_header {
    font-size: 11px;
    font-weight: 700;
    color: #64748B;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 10px 18px 4px 18px;
}

/* Pill-Shaped Navigation Buttons */
QPushButton#nav_btn {
    text-align: left;
    padding: 10px 16px;
    border-radius: 10px;
    background-color: transparent;
    color: #94A3B8;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid transparent;
    margin: 2px 12px;
}

QPushButton#nav_btn:hover {
    background-color: rgba(255, 255, 255, 0.04);
    color: #F8FAFC;
}

QPushButton#nav_btn[active="true"] {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.28);
    color: #10B981;
    font-weight: 700;
}

QPushButton#nav_btn:focus {
    border: 2px solid #10B981;
}

QPushButton#nav_btn[active="true"]:focus {
    border: 2px solid #10B981;
}

/* ─── Typography Headers & Contrast Hierarchy ──────────────────────────── */
QLabel#page_title {
    font-size: 26px;
    font-weight: 800;
    color: #F8FAFC;
    letter-spacing: -0.6px;
}

QLabel#page_subtitle {
    font-size: 13px;
    color: #94A3B8;
    font-weight: 400;
}

QLabel#section_header {
    font-size: 15px;
    font-weight: 700;
    color: #F8FAFC;
    letter-spacing: -0.2px;
}

/* High-Contrast Metric Typography */
QLabel#metric_large, QLabel#stat_card_value {
    font-size: 36px;
    font-weight: 800;
    color: #F8FAFC;
    letter-spacing: -1.0px;
}

QLabel#metric_sub {
    font-size: 12px;
    font-weight: 500;
    color: #94A3B8;
}

/* ─── Translucent Floating Surfaces ────────────────────────────────────── */
QFrame#v2_card, QFrame#apps_container, QFrame#stat_card {
    background-color: rgba(18, 22, 29, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
}

QFrame#v2_card:hover, QFrame#stat_card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(24, 30, 40, 0.85);
}

QFrame#hero_card {
    background: rgba(18, 22, 29, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

/* ─── Standard Buttons ─────────────────────────────────────────────────── */
QPushButton {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 18px;
    color: #F8FAFC;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.03);
}

QPushButton#btn_primary {
    background: #10B981;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
}

QPushButton#btn_primary:hover {
    background: #059669;
}

/* Segmented Tab Bar Buttons */
QPushButton[checkable="true"] {
    border-radius: 8px;
    background-color: rgba(18, 22, 29, 0.60);
    color: #94A3B8;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton[checkable="true"]:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #F8FAFC;
}

QPushButton[checkable="true"][active="true"] {
    background: rgba(16, 185, 129, 0.15);
    color: #10B981;
    font-weight: 700;
    border: 1px solid rgba(16, 185, 129, 0.35);
}

/* ─── Inputs & Dropdowns ───────────────────────────────────────────────── */
QComboBox, QSpinBox, QLineEdit {
    background-color: rgba(15, 18, 24, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 8px 12px;
    color: #F8FAFC;
    font-size: 13px;
}

QComboBox:hover, QSpinBox:hover, QLineEdit:hover {
    border-color: rgba(16, 185, 129, 0.45);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #11151C;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    selection-background-color: rgba(16, 185, 129, 0.15);
    selection-color: #10B981;
    padding: 4px;
}

/* ─── Scroll Areas ────────────────────────────────────────────────────── */
QScrollArea {
    border: none;
    background: transparent;
}

/* ─── Scrollbars ───────────────────────────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.14);
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.28);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.14);
    min-width: 28px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.28);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ─── Progress Bars ────────────────────────────────────────────────────── */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: #10B981;
    border-radius: 4px;
}

/* ─── Radio Buttons & Checkboxes ───────────────────────────────────────── */
QRadioButton {
    color: #F8FAFC;
    font-size: 13px;
    spacing: 10px;
    background: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background-color: rgba(15, 18, 24, 0.85);
}

QRadioButton::indicator:hover {
    border-color: rgba(16, 185, 129, 0.60);
    background-color: rgba(24, 30, 40, 0.95);
}

QRadioButton::indicator:checked {
    border: 5px solid #10B981;
    background-color: #080A0D;
}

QCheckBox {
    color: #F8FAFC;
    font-size: 13px;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.20);
    background-color: rgba(15, 18, 24, 0.85);
}

QCheckBox::indicator:hover {
    border-color: rgba(16, 185, 129, 0.60);
}

QCheckBox::indicator:checked {
    background-color: #10B981;
    border-color: #10B981;
}

/* ─── Tooltips ─────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #11151C;
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

